      <div class="h">Where you want to be</div>
      <ul class="clean">
        {% if d.target_leads is not none %}<li>Target lead flow: <b>{{ d.target_leads }}/month</b></li>{% endif %}
        {% if d.goal %}<li>Your stated goal: {{ d.goal }}</li>{% endif %}
        {% if d.dream_state %}<li>Dream state: {{ d.dream_state }}</li>{% endif %}
        {% if d.services %}<li>Services to grow: {{ d.services|join(' · ') }}</li>{% endif %}
      </ul>
    </div>
  </div>

  {% if d.pain_points %}
  <div class="card" style="margin-top:16px">
    <div class="h">Pain points you raised</div>
    <ul class="clean">{% for p in d.pain_points %}<li>{{ p }}</li>{% endfor %}</ul>
  </div>
  {% endif %}

  {% if pitch.discovery_synthesis %}
  <div class="card dark" style="margin-top:16px">
    <div class="h">What this tells us</div>
    <p style="margin:0">{{ pitch.discovery_synthesis }}</p>
  </div>
  {% endif %}
  {{ foot(page.n) }}
</section>
{% endif %}

<!-- ============ AUDIT · 1 · HEALTH SCORECARD ============ -->
{% set page.n = page.n + 1 %}
<section class="slide">
  <span class="kicker">The Audit · Health Scorecard</span>
  <h2 class="slide-title">Your digital health at a glance</h2>
  <div class="rule"></div>
  <p class="slide-sub">We ran a full technical + SEO audit of {{ domain }} — the whole site, not a single
    page — before writing a word of the plan. Here's the headline; the specifics follow.</p>

  {%- set gL = (audit_grade|string)[:1]|upper -%}
  {%- set grade_phrase = {'A':'Strong technical foundation','B':'Solid, with clear room to grow',
        'C':'Underperforming — but fixable','D':'Significant issues to address',
        'F':'Significant issues to address'}.get(gL, 'Overall SEO health') -%}
  <div class="healthband">
    <div class="gcircle {{ gcls(audit_grade) }}">{{ audit_grade or '—' }}</div>
    <div>
      <p class="hb-t">{{ grade_phrase }}</p>
      <p class="hb-p">
        {%- set fails = summary.fail or 0 %}{% set warns = summary.warn or 0 -%}
        {{ fails }} issue{{ 's' if fails != 1 }} to fix and {{ warns }} to improve, across
        {{ (summary.pass or 0) + fails + warns + (summary.info or 0) }} automated checks.
        {% if ai and ai.score is not none %} Automated health score {{ ai.score }}/100.{% endif %}
      </p>
    </div>
  </div>

  {# The big circle already IS the overall grade — the scorecard shows the
     category breakdown, so the redundant 'overall' cell is dropped to avoid a
     grade sitting twice (and, when AI and SEOptimer disagree, contradicting itself). #}
  {% set cat_cells = scorecard | rejectattr('key', 'equalto', 'overall') | list %}
  {% if cat_cells %}
  <div class="scorecard">
    {% for c in cat_cells %}
    <div class="gcard">
      <div class="g {{ gcls(c.grade) }}">{{ c.letter }}</div>
      <div class="lab">{{ c.label }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="stats" style="margin-top:16px">
    <div class="stat"><div class="n" style="color:var(--good)">{{ summary.pass or 0 }}</div><div class="l">Passing</div></div>
    <div class="stat"><div class="n" style="color:var(--gold-deep)">{{ summary.warn or 0 }}</div><div class="l">To improve</div></div>
    <div class="stat"><div class="n" style="color:var(--bad)">{{ summary.fail or 0 }}</div><div class="l">To fix</div></div>
    <div class="stat"><div class="n">{{ summary.info or 0 }}</div><div class="l">For review</div></div>
  </div>

  {# Shown here only for an audit-only deck; when a pitch exists the Executive
     Summary slide already carries the narrative, so we don't repeat it. #}
  {% if ai and ai.executive_summary and not pitch %}
  <div class="card" style="margin-top:16px;border-left:5px solid var(--gold)">
    <div class="h">What this means for you</div>
    <p style="margin:0;white-space:pre-line">{{ ai.executive_summary }}</p>
  </div>
  {% endif %}
  {{ foot(page.n) }}
</section>

<!-- ============ AUDIT · 2 · CRITICAL ISSUES ============ -->
{% set page.n = page.n + 1 %}
<section class="slide flow">
  <span class="kicker">The Audit · Critical Issues</span>
  <h2 class="slide-title">What's holding your rankings back</h2>
  <div class="rule"></div>
  <p class="slide-sub">Every row below is something the audit measured — ranked worst-first, with what
    it's costing you in plain English. This is the list the plan is built to clear.</p>

  {% if issues %}
  <table>
    <thead><tr><th style="width:19%">Issue</th><th style="width:25%">What we found</th>
      <th style="width:15%">Extent</th><th>Impact on rankings</th><th style="width:10%">Severity</th></tr></thead>
    <tbody>
      {% for i in issues %}
      <tr>
        <td><b>{{ i.issue }}</b></td>
        <td>{{ i.summary }}</td>
        <td style="color:var(--muted)">{{ i.extent }}</td>
        <td style="color:var(--ink2)">{{ i.impact }}</td>
        <td>{{ sev_pill(i.severity) }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <div class="card"><div class="h">No blocking issues flagged</div>
    <p style="margin:0">The automated checks didn't surface critical failures — so the plan focuses on
      growth and competitive gains rather than triage.</p></div>
  {% endif %}

  {% if ai and ai.quick_wins %}
  <div class="card" style="margin-top:16px;border-left:5px solid var(--gold)">
    <div class="h">Quick wins we can start with</div>
    <ul class="clean chk">{% for w in ai.quick_wins %}<li>{{ w }}</li>{% endfor %}</ul>
  </div>
  {% endif %}
  {{ foot(page.n) }}
</section>

<!-- ============ AUDIT · 3 · ON-PAGE & TECHNICAL ============ -->
{% set page.n = page.n + 1 %}
<section class="slide flow">
  <span class="kicker">The Audit · On-Page &amp; Technical</span>
  <h2 class="slide-title">Speed, mobile and on-page foundations</h2>
  <div class="rule"></div>
  <p class="slide-sub">The technical signals search engines weigh directly — and the on-page elements that
    tell them what each page is about.</p>

  <div class="stats">
    {% if metrics.load_ms %}
    <div class="stat"><div class="n">{{ "%.1f"|format(metrics.load_ms/1000) }}s</div>
      <div class="l">Page load</div><div class="h">Target: under 2s</div></div>{% endif %}
    {% if metrics.mobile_score is not none %}
    <div class="stat"><div class="n {{ 'gA' if metrics.mobile_score>=80 else ('gC' if metrics.mobile_score>=50 else 'gF') }}">{{ metrics.mobile_score }}</div>
      <div class="l">Mobile speed</div><div class="h">Google indexes mobile first</div></div>{% endif %}
    {% if metrics.desktop_score is not none %}
    <div class="stat"><div class="n {{ 'gA' if metrics.desktop_score>=80 else ('gC' if metrics.desktop_score>=50 else 'gF') }}">{{ metrics.desktop_score }}</div>
      <div class="l">Desktop speed</div><div class="h">out of 100</div></div>{% endif %}
    {% if metrics.page_bytes %}
    <div class="stat"><div class="n">{{ "%.1f"|format(metrics.page_bytes/1048576) }}<small style="font-size:14px">MB</small></div>
      <div class="l">Page weight</div><div class="h">homepage payload</div></div>{% endif %}
  </div>

  {% if metrics.lcp is not none or metrics.cls is not none or metrics.inp is not none %}
  <div class="h" style="font-weight:800;color:var(--ink);font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin:18px 0 10px">Core Web Vitals — Google's page-experience signals</div>
  <div class="grid3">
    {% if metrics.lcp is not none %}
    {% set lcp_s = (metrics.lcp/1000) if metrics.lcp > 100 else metrics.lcp %}
    <div class="card"><div class="h">LCP — Largest Contentful Paint</div>
      <div class="big" style="font-size:30px">{{ "%.1f"|format(lcp_s) }}s
        <span class="sp {{ 'pass' if lcp_s<=2.5 else ('warn' if lcp_s<=4 else 'fail') }}">{{ 'Good' if lcp_s<=2.5 else ('Needs work' if lcp_s<=4 else 'Poor') }}</span></div>
      <p style="margin:6px 0 0;color:var(--muted);font-size:11px">How fast the main content appears. Good ≤ 2.5s.</p></div>
    {% endif %}
    {% if metrics.cls is not none %}
    <div class="card"><div class="h">CLS — Cumulative Layout Shift</div>
      <div class="big" style="font-size:30px">{{ "%.2f"|format(metrics.cls) }}
        <span class="sp {{ 'pass' if metrics.cls<=0.1 else ('warn' if metrics.cls<=0.25 else 'fail') }}">{{ 'Good' if metrics.cls<=0.1 else ('Needs work' if metrics.cls<=0.25 else 'Poor') }}</span></div>
      <p style="margin:6px 0 0;color:var(--muted);font-size:11px">How much the layout jumps as it loads. Good ≤ 0.1.</p></div>
    {% endif %}
    {% if metrics.inp is not none %}
    {% set inp_ms = metrics.inp if metrics.inp > 10 else metrics.inp*1000 %}
    <div class="card"><div class="h">INP — Interaction to Next Paint</div>
      <div class="big" style="font-size:30px">{{ inp_ms|round|int }}<small style="font-size:13px">ms</small>
        <span class="sp {{ 'pass' if inp_ms<=200 else ('warn' if inp_ms<=500 else 'fail') }}">{{ 'Good' if inp_ms<=200 else ('Needs work' if inp_ms<=500 else 'Poor') }}</span></div>
      <p style="margin:6px 0 0;color:var(--muted);font-size:11px">How quickly the page responds to a tap/click. Good ≤ 200ms.</p></div>
    {% endif %}
  </div>
  {% endif %}

  {% if site_analysis %}
  <div class="h" style="font-weight:800;color:var(--ink);font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin:18px 0 10px">
    Whole-site issues{% if crawl and crawl.pages_crawled %} — across {{ num(crawl.pages_crawled) }} crawled pages{% endif %}</div>
  <table>
    <thead><tr><th style="width:30%">Issue</th><th style="width:26%">Extent</th>
      <th>What it means</th><th style="width:11%">Status</th></tr></thead>
    <tbody>
      {% for row in site_analysis %}
      <tr>
        <td><b>{{ row.element }}</b></td>
        <td style="color:var(--muted)">{{ row.current }}</td>
        <td>{{ row.verdict }}</td>
        <td><span class="sp {{ row.status }}">{{ row.status }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if homepage %}
  <div class="h" style="font-weight:800;color:var(--ink);font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin:18px 0 10px">Homepage on-page elements</div>
  <table>
    <thead><tr><th style="width:20%">Element</th><th style="width:30%">What's there now</th>
      <th>Verdict</th><th style="width:11%">Status</th></tr></thead>
    <tbody>
      {% for row in homepage %}
      <tr>
        <td><b>{{ row.element }}</b></td>
        <td style="color:var(--muted)">{{ row.current }}</td>
        <td>{{ row.verdict }}</td>
        <td><span class="sp {{ row.status }}">{{ row.status }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {{ foot(page.n) }}
</section>

<!-- ============ AUDIT · 4 · ORGANIC SEARCH PERFORMANCE ============ -->
{% set page.n = page.n + 1 %}
<section class="slide flow">
  <span class="kicker">The Audit · Organic Search</span>
  <h2 class="slide-title">Where you rank and what it's worth</h2>
  <div class="rule"></div>
  <p class="slide-sub">Domain-wide organic visibility for {{ domain }} — the traffic you earn today, the
    keywords behind it, and the backlink authority holding it up.</p>

  <div class="stats">
    {% if metrics.organic_traffic is not none %}
    <div class="stat"><div class="n gold">{{ num(metrics.organic_traffic) }}</div>
      <div class="l">Monthly organic visits</div><div class="h">current estimate</div></div>{% endif %}
    {% if metrics.keywords_total is not none %}
    <div class="stat"><div class="n">{{ num(metrics.keywords_total) }}</div>
      <div class="l">Ranking keywords</div></div>{% endif %}
    {% if metrics.referring_domains is not none %}
    <div class="stat"><div class="n">{{ num(metrics.referring_domains) }}</div>
      <div class="l">Referring domains</div></div>{% endif %}
    {% if crawl and crawl.pages_crawled %}
    <div class="stat"><div class="n">{{ num(crawl.pages_crawled) }}</div>
      <div class="l">Pages crawled</div><div class="h">whole-domain audit</div></div>{% endif %}
  </div>

  {% if metrics.positions %}
  {% set P = metrics.positions %}
  {% set maxp = [P['1-3'], P['4-10'], P['11-20'], P['21-50'], P['51-100']]|max %}
  <div class="h" style="font-weight:800;color:var(--ink);font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin:18px 0 8px">Where your keywords rank</div>
  <div class="bars">
    {% for label, key, cls in [('Positions 1-3','1-3','win'), ('Page 1 (4-10)','4-10','win'),
                               ('Page 2 (11-20)','11-20','mid'), ('Positions 21-50','21-50',''),
                               ('Positions 51-100','51-100','')] %}
    <div class="bar">
      <div class="blab">{{ label }}</div>
      <div class="btrack"><div class="bfill {{ cls }}" style="width:{{ ((P[key]/maxp*100)|round|int) if maxp else 0 }}%"></div></div>
      <div class="bval">{{ P[key] }}</div>
    </div>
    {% endfor %}
  </div>
  <p class="snap">The keywords in positions 11-100 are the fastest wins: already ranking, one page away
    from the traffic that actually converts.</p>
  {% endif %}

  {# The real ranking-keyword table lives on the Keyword Strategy slide when a
     pitch is present; here it's shown only for an audit-only deck so the terms
     appear exactly once. #}
  {% if metrics.top_keywords and not pitch %}
  <div class="h" style="font-weight:800;color:var(--ink);font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin:18px 0 8px">Keywords you rank for today</div>
  <table>
    <thead><tr><th style="width:46%">Keyword</th><th class="num" style="text-align:right">Position</th>
      <th class="num" style="text-align:right">Volume / mo</th><th class="num" style="text-align:right">Est. traffic / mo</th></tr></thead>
    <tbody>
      {% for k in metrics.top_keywords %}
      <tr>
        <td><b>{{ k.keyword }}</b>{% if k.country %} <span style="color:var(--muted);font-weight:400">· {{ k.country }}</span>{% endif %}</td>
        <td style="text-align:right;font-variant-numeric:tabular-nums">{{ k.position if k.position is not none else '—' }}</td>
        <td style="text-align:right;font-variant-numeric:tabular-nums">{{ num(k.volume) }}</td>
        <td style="text-align:right;font-variant-numeric:tabular-nums">{{ num(k.traffic) }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="snap">These are the domain's current top-earning search terms, measured from live ranking data.</p>
  {% endif %}

  {% if metrics.backlinks is not none or metrics.internal_links is not none %}
  <div class="grid2" style="margin-top:14px">
    {% if metrics.backlinks is not none or metrics.referring_domains is not none %}
    <div class="card">
      <div class="h">Backlink profile</div>
      <ul class="clean">
        {% if metrics.backlinks is not none %}<li>Total backlinks <b>{{ num(metrics.backlinks) }}</b></li>{% endif %}
        {% if metrics.referring_domains is not none %}<li>Referring domains <b>{{ num(metrics.referring_domains) }}</b></li>{% endif %}
        {% if metrics.dofollow_backlinks is not none %}<li>Dofollow links <b>{{ num(metrics.dofollow_backlinks) }}</b></li>{% endif %}
        {% if metrics.edu_backlinks is not none or metrics.gov_backlinks is not none %}<li>.edu / .gov links <b>{{ num(metrics.edu_backlinks) }} / {{ num(metrics.gov_backlinks) }}</b></li>{% endif %}
      </ul>
    </div>
    {% endif %}
    {% if metrics.internal_links is not none or metrics.content_words is not none %}
    <div class="card">
      <div class="h">On-site signals</div>
      <ul class="clean">
        {% if metrics.internal_links is not none %}<li>Internal links (homepage) <b>{{ num(metrics.internal_links) }}</b></li>{% endif %}
        {% if metrics.external_links is not none %}<li>External links (homepage) <b>{{ num(metrics.external_links) }}</b></li>{% endif %}
        {% if metrics.content_words is not none %}<li>Homepage content depth <b>{{ num(metrics.content_words) }} words</b></li>{% endif %}
        {% if metrics.ai_traffic is not none %}<li>Est. AI-search traffic <b>{{ num(metrics.ai_traffic) }}/mo</b></li>{% endif %}
      </ul>
    </div>
    {% endif %}
  </div>
  {% endif %}

  {% if metrics.organic_traffic is none and not metrics.top_keywords and not metrics.positions %}
  <div class="card" style="margin-top:14px"><div class="h">Organic data</div>
    <p style="margin:0;color:var(--muted)">Live keyword and traffic estimates weren't available for this
      run. The Month-0 keyword research phase establishes the full ranking baseline.</p></div>
  {% endif %}
  {{ foot(page.n) }}
</section>

{% if comparison %}
<!-- ============ 3 · COMPETITIVE LANDSCAPE ============ -->
{% set page.n = page.n + 1 %}
<section class="slide flow">
  <span class="kicker">03 · Competitive Landscape</span>
  <h2 class="slide-title">Who you're competing against</h2>
  <div class="rule"></div>
  <p class="slide-sub">We ran the same audit against {{ comparison.count }}
    competitor{{ 's' if comparison.count != 1 }}. Every number below is measured, not estimated —
    check any of it.</p>

  <table class="compare">
    <thead><tr>
      <th style="width:26%">Site</th><th class="num">Authority</th><th class="num">Organic traffic</th>
      <th class="num">Ranking keywords</th><th class="num">Referring domains</th><th class="num">Backlinks</th>
    </tr></thead>
    <tbody>
      {% for r in comparison.rows %}
      <tr class="{{ 'me' if r.is_client }}">
        <td>{{ r.name }}{% if r.is_client %} <span style="font-weight:400;color:var(--muted)">(you)</span>{% endif %}</td>
        <td class="num">{{ r.authority if r.authority is not none else "—" }}</td>
        <td class="num">{{ num(r.traffic) }}</td>
        <td class="num">{{ r.keywords if r.keywords is not none else "—" }}</td>
        <td class="num">{{ num(r.referring_domains) }}</td>
        <td class="num">{{ num(r.backlinks) }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="note">Authority is a 0-100 domain strength score. Traffic and ranking keywords are
    third-party estimates over a sample of tracked keywords, measured identically for every site
    here — so the comparison is fair even where the absolute numbers are directional.</p>

  {% if pitch.competitor_insights %}
  <div class="h" style="font-weight:800;color:var(--ink);font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin:20px 0 10px">What they're doing right</div>
  <div class="grid2">
    {% for ins in pitch.competitor_insights %}
    <div class="card">
      <div class="h">{{ ins.domain }}</div>
      {% if ins.doing_right %}<ul class="clean">{% for x in ins.doing_right %}<li>{{ x }}</li>{% endfor %}</ul>{% endif %}
      {% if ins.takeaway %}<div style="margin-top:8px;border-left:3px solid var(--gold);padding-left:10px;font-size:11.5px">
        <b>Our move:</b> {{ ins.takeaway }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {{ foot(page.n) }}
</section>

<!-- ============ THE COMPETITIVE GAP ============ -->
{% set page.n = page.n + 1 %}
<section class="slide">
  <span class="kicker">03 · The Gap</span>
  <h2 class="slide-title">What it will take to close it</h2>
  <div class="rule"></div>
  <p class="slide-sub">The distance between where you are and where the market leader is — stated
    plainly, because it's what determines the size of the campaign.</p>

  {% set g = proj.gaps if proj else none %}
  {% if g %}
  <div class="stats" style="grid-template-columns:repeat(3,1fr)">
    {% if g.traffic and g.traffic.gap %}
    <div class="stat"><div class="n">{{ num(g.traffic.gap) }}</div>
      <div class="l">Monthly visits behind</div>
      <div class="h">vs {{ g.traffic.leader }}, the strongest site in your set.</div></div>
    {% endif %}
    {% if g.referring_domains and g.referring_domains.gap %}
    <div class="stat"><div class="n">{{ num(g.referring_domains.gap) }}</div>
      <div class="l">Referring domains behind</div>
      <div class="h">{% if proj.authority and not proj.authority.parity_realistic %}Too wide to close on
        count alone — we target relevant authority instead.{% elif proj.authority %}Closable within the
        campaign at {{ proj.authority.delivered_range }} earned domains/month.{% endif %}</div></div>
    {% endif %}
    {% if g.authority and g.authority.gap %}
    <div class="stat"><div class="n">{{ g.authority.gap }}</div>
      <div class="l">Authority points behind</div>
      <div class="h">Domain strength vs the leader.</div></div>
    {% endif %}
  </div>
  {% endif %}

  <div style="margin-top:18px">
    {% if pitch.gap_narrative.content %}
    <div class="card" style="margin-bottom:12px"><div class="h">The content gap</div>
      <p style="margin:0">{{ pitch.gap_narrative.content }}</p></div>
    {% endif %}
    {% if pitch.gap_narrative.authority %}
    <div class="card" style="margin-bottom:12px"><div class="h">The authority gap</div>
      <p style="margin:0">{{ pitch.gap_narrative.authority }}</p></div>
    {% endif %}
    {% if g and g.speed and g.speed.mine_s and g.speed.best_s %}
    <div class="card"><div class="h">The technical gap</div>
      <p style="margin:0">Your homepage loads in <b>{{ g.speed.mine_s }}s</b>; the fastest competitor
        in your set loads in <b>{{ g.speed.best_s }}s</b>{% if g.speed.avg_s %}, and the set averages
