        {% if d.close_rate is not none %}<li>Close rate: <b>{{ "%g"|format(d.close_rate) }}%</b></li>{% endif %}
        {% if d.deals_per_month is not none %}<li>Deals closed: <b>{{ d.deals_per_month }}/month</b></li>{% endif %}
        {% if d.avg_deal_value is not none %}<li>Average deal value: <b>{{ d.money(d.avg_deal_value) }}</b></li>{% endif %}
        {% if d.geo_focus %}<li>Geographic focus: <b>{{ d.geo_focus }}</b></li>{% endif %}
