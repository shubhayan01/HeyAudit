<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>SEO Audit &amp; Growth Plan — {{ client_name }}</title>
<style>
  :root{
    --gold:#FFD400; --gold-deep:#E8B800; --gold-soft:#FFF7CC;
    --ink:#111111; --ink2:#2b2b2b; --paper:#ffffff;
    --muted:#6c6c6c; --line:#e7e7e7; --line2:#d9d9d9;
    --good:#188a4e; --bad:#c0392b;
  }
  *{box-sizing:border-box}
  html{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  body{font-family:-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
       color:var(--ink2);margin:0;background:#4a4a4a;font-size:13px;line-height:1.6}

  /* Each slide is one A4 page. */
  .slide{position:relative;width:210mm;min-height:297mm;margin:0 auto;background:var(--paper);
         padding:22mm 20mm;overflow:hidden;page-break-after:always;box-shadow:0 6px 24px rgba(0,0,0,.25)}
  .slide:last-child{page-break-after:auto}
  @media screen{ .slide{margin:16px auto} }
  /* A slide whose content can exceed one page: let it flow and paginate. */
  .slide.flow{min-height:auto;overflow:visible}
  .slide.flow .foot{position:static;left:auto;right:auto;bottom:auto;margin-top:22px}

  h1,h2,h3{color:var(--ink);margin:0;line-height:1.2;font-weight:800;letter-spacing:-.01em}
  p{margin:0 0 10px}
  .kicker{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.16em;
          text-transform:uppercase;color:var(--ink);background:var(--gold);
          padding:5px 11px;border-radius:3px}
  .slide-title{font-size:27px;margin:14px 0 4px}
  .slide-sub{color:var(--muted);font-size:13.5px;margin-bottom:22px;max-width:62ch}
  .rule{height:4px;width:56px;background:var(--gold);border-radius:2px;margin:14px 0 20px}

  .foot{position:absolute;left:20mm;right:20mm;bottom:12mm;display:flex;justify-content:space-between;
        align-items:center;font-size:10px;color:var(--muted);border-top:1px solid var(--line);padding-top:8px}
  .foot b{color:var(--ink)}

  /* ---------- Cover ---------- */
  .cover{background:var(--ink);color:#fff;display:flex;flex-direction:column;justify-content:center}
  .cover::before{content:"";position:absolute;top:0;left:0;right:0;height:14px;background:var(--gold)}
  .cover::after{content:"";position:absolute;right:-90px;bottom:-90px;width:340px;height:340px;
                border:36px solid var(--gold);border-radius:50%;opacity:.16}
  .cover .brand{font-size:13px;font-weight:800;letter-spacing:.28em;text-transform:uppercase;color:var(--gold)}
  .cover h1{color:#fff;font-size:46px;line-height:1.08;margin:20px 0 0;max-width:16ch}
  .cover h1 .hl{color:var(--gold)}
  .cover .for{margin-top:30px;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#bdbdbd}
  .cover .client{font-size:24px;font-weight:800;color:#fff;margin-top:4px}
  .cover .client small{display:block;font-size:13px;font-weight:400;color:#9a9a9a;letter-spacing:0;text-transform:none;margin-top:3px}
  .cover .meta{position:absolute;left:20mm;bottom:16mm;font-size:11px;color:#9a9a9a}
  .cover .meta b{color:#fff}
  .cover .tags{margin-top:26px;display:flex;gap:8px;flex-wrap:wrap}
  .cover .tags span{border:1px solid #3a3a3a;color:#e8e8e8;font-size:11px;font-weight:700;
                    padding:5px 12px;border-radius:20px}
  .cover .tags span b{color:var(--gold)}

  /* ---------- Generic building blocks ---------- */
  .lead{font-size:15px;color:var(--ink2);line-height:1.75}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .card{border:1px solid var(--line);border-radius:10px;padding:16px 18px;background:#fff}
  .card.dark{background:var(--ink);color:#eaeaea;border-color:var(--ink)}
  .card.dark h3{color:#fff}
  .card .h{font-weight:800;color:var(--ink);font-size:14px;margin-bottom:6px}
  .card.dark .h{color:var(--gold)}
  ul.clean{list-style:none;margin:0;padding:0}
  ul.clean li{position:relative;padding:5px 0 5px 22px;border-bottom:1px solid var(--line)}
  ul.clean li:last-child{border-bottom:none}
  ul.clean li::before{content:"";position:absolute;left:0;top:12px;width:9px;height:9px;
                      background:var(--gold);border-radius:2px}
  .chk li::before{content:"✓";background:none;color:var(--gold-deep);font-weight:900;top:5px;left:2px;width:auto;height:auto}

  table{width:100%;border-collapse:collapse;font-size:12px}
  thead th{background:var(--ink);color:#fff;text-align:left;padding:9px 11px;font-size:11px;
           letter-spacing:.04em;text-transform:uppercase;font-weight:700}
  tbody td{padding:9px 11px;border-bottom:1px solid var(--line);vertical-align:top}
  tbody tr:nth-child(even){background:#fbfbf6}
  .pill{display:inline-block;padding:2px 9px;border-radius:20px;font-size:10.5px;font-weight:800}
  .pill.info{background:#eef2ff;color:#2f4bce} .pill.trans{background:var(--gold);color:var(--ink)}
  .pill.comm{background:var(--gold-soft);color:#7a5c00;border:1px solid var(--gold-deep)}
  .pill.nav{background:#eee;color:#444}
  .pill.low{background:#e6f6ec;color:#177544} .pill.med{background:var(--gold-soft);color:#7a5c00}
  .pill.high{background:#fde8e8;color:#c0392b}

  /* ---------- TOC ---------- */
  ol.toc{list-style:none;counter-reset:t;margin:0;padding:0;columns:2;column-gap:26px}
  ol.toc li{counter-increment:t;padding:9px 0 9px 34px;position:relative;border-bottom:1px solid var(--line);
            font-weight:600;color:var(--ink);break-inside:avoid}
  ol.toc li::before{content:counter(t);position:absolute;left:0;top:8px;width:22px;height:22px;
       background:var(--gold);color:var(--ink);font-size:11px;font-weight:900;border-radius:4px;
       display:flex;align-items:center;justify-content:center}
  ol.toc li small{display:block;font-weight:400;color:var(--muted);font-size:11px}

  /* ---------- Stat tiles ---------- */
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
  .stat{border:1px solid var(--line);border-radius:10px;padding:14px 15px;background:#fff}
  .stat .n{font-size:25px;font-weight:900;color:var(--ink);line-height:1.1}
  .stat .n.gold{color:var(--gold-deep)}
  .stat .l{font-size:10px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);
           margin-top:6px;font-weight:700}
  .stat .h{font-size:10.5px;color:var(--muted);margin-top:4px;line-height:1.4}

  /* ---------- Comparison table ---------- */
  table.compare tbody tr.me{background:var(--gold-soft)!important}
  table.compare tbody tr.me td{font-weight:800;color:var(--ink);border-top:2px solid var(--gold-deep);
                               border-bottom:2px solid var(--gold-deep)}
  table.compare td.num{text-align:right;font-variant-numeric:tabular-nums}
  table.compare th.num{text-align:right}
  .gapbadge{font-size:10px;font-weight:800;color:var(--bad)}

  /* Roadmap */
  .months{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .mo{border:1px solid var(--line);border-left:5px solid var(--gold);border-radius:8px;padding:12px 15px;
      break-inside:avoid}
  .mo .n{display:inline-block;font-size:10.5px;font-weight:900;letter-spacing:.1em;text-transform:uppercase;
         color:var(--ink);background:var(--gold);padding:2px 9px;border-radius:3px}
  .mo h3{font-size:14.5px;margin:8px 0 2px}
  .mo .focus{color:var(--muted);font-size:11.5px;margin-bottom:7px}
  .mo ul{margin:0 0 6px;padding-left:16px;font-size:11.5px;color:var(--ink2)}
  .mo li{margin:2px 0}
  .mo .plab{font-size:9.5px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;
            color:var(--gold-deep);margin-top:7px}

  /* Pillars */
  .pillar{border:1px solid var(--line);border-radius:10px;padding:18px 20px;margin-bottom:14px;
          break-inside:avoid;border-top:5px solid var(--gold)}
  .pillar .pn{font-size:10.5px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-deep)}
  .pillar h3{font-size:18px;margin:5px 0 8px}
  .pillar .why{margin-top:10px;border-left:3px solid var(--gold);padding:4px 0 4px 12px;
               font-size:12px;color:var(--ink2);background:#fffdf2}

  /* Options A/B/C */
  .opts{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;align-items:start}
  .opt{border:1px solid var(--line2);border-radius:12px;padding:18px 16px;background:#fff;position:relative}
  .opt.rec{border:2px solid var(--ink);background:var(--ink);color:#eaeaea;box-shadow:0 8px 20px rgba(0,0,0,.18)}
  .opt.rec .ol,.opt.rec h3{color:#fff}
  .opt.rec .price{color:var(--gold)}
  .opt .flag{position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:var(--gold);
             color:var(--ink);font-size:9px;font-weight:900;letter-spacing:.1em;padding:3px 12px;border-radius:20px;
             white-space:nowrap}
  .opt .ol{font-size:10.5px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  .opt h3{font-size:17px;margin:5px 0 3px}
  .opt .blurb{font-size:11px;color:var(--muted);min-height:32px}
  .opt.rec .blurb{color:#b9b9b9}
  .opt .price{font-size:15px;font-weight:900;color:var(--ink);margin:10px 0 2px;line-height:1.35}
  .opt .kwr{font-size:11px;color:var(--muted);border-top:1px solid var(--line);padding-top:8px;margin-top:8px}
  .opt.rec .kwr{border-color:#3a3a3a;color:#c9c9c9}
  .opt ul{margin:8px 0 0;padding-left:15px;font-size:11px}
  .opt li{margin:3px 0}

  /* Matrix */
  table.matrix td:first-child{font-weight:600;color:var(--ink2)}
  table.matrix thead th:not(:first-child){text-align:center}
  table.matrix td:not(:first-child){text-align:center}
  table.matrix .yes{color:var(--gold-deep);font-weight:900}
  table.matrix .no{color:#c9c9c9}
  table.matrix .cnt{font-weight:700;color:var(--ink)}
  .catrow td{background:var(--gold-soft)!important;font-weight:800;color:var(--ink);
             font-size:11px;letter-spacing:.05em;text-transform:uppercase}
  .col-on{background:#fffdf0}

  /* Moat */
  .moat{background:var(--ink);color:#f2f2f2;border-radius:12px;padding:26px 28px;position:relative;overflow:hidden}
  .moat::after{content:"";position:absolute;right:-70px;top:-70px;width:220px;height:220px;border:30px solid var(--gold);border-radius:50%;opacity:.18}
  .moat .tag{color:var(--gold);font-weight:800;letter-spacing:.16em;text-transform:uppercase;font-size:11px}
  .moat h2{color:#fff;font-size:24px;margin:10px 0 14px;max-width:22ch}
  .moat p{color:#dcdcdc;font-size:14px}
  .moat .why{margin-top:16px;border-left:4px solid var(--gold);padding:6px 0 6px 16px;color:#fff}

  .cta{background:var(--gold);border-radius:12px;padding:22px 26px;color:var(--ink);text-align:center;margin-top:22px}
  .cta h3{font-size:20px}
  .cta p{margin:6px 0 0;font-weight:600}
  .note{font-size:10.5px;color:var(--muted);font-style:italic;margin-top:10px}
  .assump{font-size:10px;color:var(--muted);margin-top:12px;border-top:1px solid var(--line);padding-top:8px}
  .assump li{margin:3px 0}
  .big{font-size:40px;font-weight:900;color:var(--ink);line-height:1}
  .big small{font-size:13px;color:var(--muted);font-weight:600}

  /* Steps */
  .step{display:flex;gap:14px;padding:11px 0;border-bottom:1px solid var(--line);break-inside:avoid}
  .step:last-child{border-bottom:none}
  .step .sn{flex:none;width:26px;height:26px;border-radius:50%;background:var(--gold);color:var(--ink);
            font-weight:900;font-size:12px;display:flex;align-items:center;justify-content:center}
  .step .sb b{color:var(--ink);font-size:13.5px}
  .step .sb div{color:var(--muted);font-size:12px}

  /* ---------- Audit: health scorecard ---------- */
  .healthband{display:flex;gap:22px;align-items:center;background:var(--ink);border-radius:14px;
              padding:22px 26px;color:#eaeaea}
  .gcircle{width:104px;height:104px;border-radius:50%;display:flex;align-items:center;justify-content:center;
           font-size:46px;font-weight:900;color:#fff;background:#3a3a3a;flex:none;border:5px solid rgba(255,255,255,.15)}
  .gcircle.gA,.gcircle.gB{background:var(--good)} .gcircle.gC{background:var(--gold-deep);color:var(--ink)}
  .gcircle.gD,.gcircle.gF{background:var(--bad)}
  .healthband .hb-t{color:#fff;font-size:18px;font-weight:800;margin:0 0 4px}
  .healthband .hb-p{color:#c9c9c9;font-size:12.5px;margin:0}
  .scorecard{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:16px}
  .gcard{border:1px solid var(--line);border-radius:10px;padding:12px 10px;text-align:center;background:#fff}
  .gcard .g{font-size:25px;font-weight:900;line-height:1}
  .gcard .lab{font-size:9.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);
              margin-top:6px;font-weight:700}
  .gA,.gB{color:var(--good)} .gC{color:var(--gold-deep)} .gD,.gF{color:var(--bad)}

  /* Severity + status pills */
  .pill.crit{background:#fce4e4;color:#a01d1d;border:1px solid #e6a6a6}
  .sp{display:inline-block;padding:2px 9px;border-radius:20px;font-size:10px;font-weight:800;text-transform:uppercase;white-space:nowrap}
  .sp.pass{background:#e6f6ec;color:#177544} .sp.warn{background:var(--gold-soft);color:#7a5c00}
  .sp.fail{background:#fde8e8;color:#c0392b} .sp.info{background:#eef2ff;color:#2f4bce}

  /* Keyword-position distribution bars */
  .bars{margin-top:6px}
  .bar{display:flex;align-items:center;gap:10px;margin:5px 0}
  .bar .blab{width:112px;font-size:11px;color:var(--ink2);font-weight:700;flex:none}
  .bar .btrack{flex:1;background:#f0f0e8;border-radius:4px;height:16px;overflow:hidden}
  .bar .bfill{height:100%;background:var(--gold);border-radius:4px;min-width:2px}
  .bar .bfill.win{background:var(--good)} .bar .bfill.mid{background:var(--gold-deep)}
  .bar .bval{width:40px;text-align:right;font-size:11px;font-weight:800;color:var(--ink);flex:none}
  .snap{font-size:10px;color:var(--muted);font-style:italic;margin-top:8px}

  @media print{
    body{background:#fff} .slide{margin:0;box-shadow:none;width:auto;min-height:auto}
    table.matrix thead,table.compare thead{display:table-header-group}
    table.matrix tr,table.compare tr,.mo,.card,.pillar,.opt,.stat{page-break-inside:avoid}
    .healthband,.gcard,.bar{page-break-inside:avoid}
  }
</style>
</head>
<body>

{% macro foot(n) %}
<div class="foot"><span><b>Justwords</b> · SEO / GEO / AEO Growth Proposal</span>
  <span>{{ client_name }}</span><span>{{ n }}</span></div>
{% endmacro %}

{% macro intent_pill(intent) %}
  {%- set i = intent|lower -%}
  {%- if 'trans' in i -%}<span class="pill trans">Transactional</span>
  {%- elif 'comm' in i -%}<span class="pill comm">Commercial</span>
  {%- elif 'nav' in i -%}<span class="pill nav">Navigational</span>
  {%- else -%}<span class="pill info">Informational</span>{%- endif -%}
{% endmacro %}

{% macro cell(v) %}
  {%- if v is sameas true -%}<span class="yes">✓</span>
  {%- elif v is sameas false -%}<span class="no">—</span>
  {%- else -%}<span class="cnt">{{ v }}</span>{%- endif -%}
{% endmacro %}

{# thousands-separate real numbers; pass strings through as-is; blank -> em dash #}
{% macro num(v) %}{% if v is number %}{{ "{:,}".format(v) }}{% elif v is not none and v|string|trim != '' %}{{ v }}{% else %}—{% endif %}{% endmacro %}

{# grade letter -> css class (gA..gF); '—'/blank -> empty #}
{% macro gcls(grade) %}{% set L = (grade|string)[:1]|upper %}{% if L in 'ABCDF' %}g{{ L }}{% endif %}{% endmacro %}

{% macro sev_pill(sev) %}
  {%- set s = sev|lower -%}
  {%- if 'crit' in s -%}<span class="pill crit">Critical</span>
  {%- elif 'high' in s -%}<span class="pill high">High</span>
  {%- elif 'low' in s -%}<span class="pill low">Low</span>
  {%- elif 'info' in s -%}<span class="pill nav">Info</span>
  {%- else -%}<span class="pill med">Medium</span>{%- endif -%}
{% endmacro %}

{% set has_discovery = not d.is_empty %}
{% set page = namespace(n=1) %}

<!-- ============ COVER ============ -->
<section class="slide cover">
  <div class="brand">Justwords</div>
  <h1>SEO Audit &amp; <span class="hl">Growth Plan</span></h1>
  <div class="tags">
    <span><b>The Audit</b> — what we found</span>
    <span><b>The Plan</b> — how we fix it</span>
    <span><b>The Growth</b> — what it's worth</span>
  </div>
  <div class="for">Prepared exclusively for</div>
  <div class="client">{{ client_name }}<small>{{ url }}</small></div>
  <div class="meta">
    {% if d.prepared_by %}Prepared by <b>{{ d.prepared_by }}</b>{% if d.prepared_by_title %}, {{ d.prepared_by_title }}{% endif %}<br>{% endif %}
    Agency: <b>Justwords</b> &nbsp;·&nbsp; {{ generated }}
    {% if audit_grade %} &nbsp;·&nbsp; Current audit grade <b>{{ audit_grade }}</b>{% endif %}<br>
    Proposal valid until <b>{{ valid_until }}</b>
  </div>
</section>

<!-- ============ EXECUTIVE SUMMARY ============ -->
{% set page.n = page.n + 1 %}
<section class="slide">
  <span class="kicker">Executive Summary</span>
  <h2 class="slide-title">What we found — and what we'll do about it</h2>
  <div class="rule"></div>
  {% if pitch and pitch.client_descriptor %}<p class="slide-sub">Prepared for {{ pitch.client_descriptor }}.</p>{% endif %}
  {% if ai and ai.headline %}<p class="lead" style="font-weight:700;color:var(--ink)">{{ ai.headline }}</p>{% endif %}
  <p class="lead">{{ (pitch.executive_summary if pitch else '') or (ai.executive_summary if ai else '')
     or 'This deck sets out what our audit of ' ~ domain ~ ' found and the plan to turn those findings into organic growth.' }}</p>

  {% if metrics.organic_traffic is not none or metrics.referring_domains is not none or (crawl and crawl.pages_crawled) %}
  <div class="h" style="font-weight:800;color:var(--ink);font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin:22px 0 10px">Where you stand today</div>
  <div class="stats">
    {% if metrics.organic_traffic is not none %}
    <div class="stat"><div class="n">{{ num(metrics.organic_traffic) }}</div>
      <div class="l">Monthly organic visits</div></div>
    {% endif %}
    {% if metrics.keywords_total is not none %}
    <div class="stat"><div class="n">{{ metrics.keywords_total }}</div>
      <div class="l">Ranking keywords</div></div>
    {% endif %}
    {% if metrics.referring_domains is not none %}
    <div class="stat"><div class="n">{{ num(metrics.referring_domains) }}</div>
      <div class="l">Referring domains</div></div>
    {% endif %}
    {% if has_discovery and d.current_leads is not none %}
    <div class="stat"><div class="n">{{ d.current_leads }}</div>
      <div class="l">Inbound leads / month</div></div>
    {% endif %}
  </div>
  {% endif %}

  {% if pitch %}
  <div class="grid2" style="margin-top:20px">
    <div class="card">
      <div class="h">What success looks like — 12 months</div>
      <ul class="clean">
        {% if pitch.success_vision.m3_6 %}<li><b>Months 3-6.</b> {{ pitch.success_vision.m3_6 }}</li>{% endif %}
        {% if pitch.success_vision.m9_12 %}<li><b>Months 9-12.</b> {{ pitch.success_vision.m9_12 }}</li>{% endif %}
        {% if pitch.success_vision.m12_plus %}<li><b>Month 12+.</b> {{ pitch.success_vision.m12_plus }}</li>{% endif %}
      </ul>
    </div>
    <div class="card dark">
      <div class="h">The outcome</div>
      <p style="margin:0">Higher rankings on high-intent search, visibility inside AI answer engines
      (ChatGPT, Perplexity, Google AI Overviews), and a compounding pipeline of qualified leads.</p>
      {% if pitch.goal_restated %}
      <div style="margin-top:12px;border-top:1px solid #333;padding-top:10px">
        <div style="color:var(--gold);font-size:10.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase">Your goal</div>
        <p style="margin:4px 0 0">{{ pitch.goal_restated }}</p>
      </div>
      {% endif %}
    </div>
  </div>
  {% if pitch.what_it_will_take %}
  <div class="card" style="margin-top:16px;border-left:5px solid var(--gold)">
    <div class="h">What it will take</div>
    <p style="margin:0">{{ pitch.what_it_will_take }}</p>
  </div>
  {% endif %}
  {% endif %}
  {{ foot(page.n) }}
</section>

<!-- ============ TABLE OF CONTENTS ============ -->
{% set page.n = page.n + 1 %}
<section class="slide">
  <span class="kicker">Contents</span>
  <h2 class="slide-title">What's in this proposal</h2>
  <div class="rule"></div>
  <ol class="toc">
    {% if has_discovery %}<li>Discovery Call Findings<small>What you told us</small></li>{% endif %}
    <li>Digital Health Scorecard<small>The audit at a glance</small></li>
    <li>Critical Issues<small>What's broken and what it costs</small></li>
    <li>On-Page &amp; Technical Health<small>Speed, mobile, Core Web Vitals</small></li>
    <li>Organic Search Performance<small>Traffic, rankings, backlinks</small></li>
    {% if comparison %}<li>Competitive Landscape<small>Who you're up against</small></li>{% endif %}
    {% if pitch %}
    {% if proj %}<li>The Opportunity<small>What the gap is costing you</small></li>{% endif %}
    <li>Our Three-Pillar Strategy<small>How we win</small></li>
    <li>Campaign Roadmap<small>Months 0-12</small></li>
    <li>Keyword Strategy<small>Real rankings and new clusters</small></li>
    <li>What We'll Deliver Each Month<small>Contracted deliverables</small></li>
    <li>Investment &amp; Timeline<small>Options A, B and C</small></li>
    <li>Why Justwords<small>How we work</small></li>
    <li>Next Steps<small>How we start</small></li>
    {% endif %}
  </ol>
  {{ foot(page.n) }}
</section>

{% if has_discovery %}
<!-- ============ 1 · DISCOVERY CALL FINDINGS ============ -->
{% set page.n = page.n + 1 %}
<section class="slide">
  <span class="kicker">01 · Discovery</span>
  <h2 class="slide-title">What you told us</h2>
  <div class="rule"></div>
  <p class="slide-sub">Everything in this proposal is built around what you said on our call — not a
