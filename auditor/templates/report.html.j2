<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Digital Health Assessment — {{ client_name }}</title>
<style>
  :root{
    --pass:#188a4e; --warn:#c07a00; --fail:#d23a3a; --info:#2f6fce;
    --ink:#141821; --body:#333a45; --muted:#727a86; --line:#e7eaee;
    --bg:#f5f7fa; --card:#ffffff; --accent:#3d5afe; --gold:#FFD400;
    --gA:#188a4e; --gB:#4e9a3a; --gC:#c07a00; --gD:#dd6a20; --gF:#d23a3a;
  }
  *{box-sizing:border-box}
  html{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  body{font-family:-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
       color:var(--body);margin:0;background:var(--bg);font-size:13.5px;line-height:1.6}
  .wrap{max-width:1000px;margin:0 auto;padding:0 0 60px}
  a{color:var(--accent);text-decoration:none}

  /* ---------- Cover ---------- */
  .cover{background:linear-gradient(135deg,#161d33 0%,#243b6b 60%,#2f56b5 100%);
         color:#fff;padding:52px 46px 44px;border-radius:0 0 22px 22px}
  .cover .eyebrow{font-size:11px;letter-spacing:.28em;text-transform:uppercase;
                  color:#aebbdd;font-weight:600}
  .cover h1{font-size:38px;margin:12px 0 4px;font-weight:700;letter-spacing:-.5px;line-height:1.1}
  .cover .u{color:#c8d3ee;font-size:14px}
  .cover .metaline{margin-top:20px;font-size:12.5px;color:#c8d3ee;
                   border-top:1px solid rgba(255,255,255,.16);padding-top:16px;
                   display:flex;gap:28px;flex-wrap:wrap}
  .cover .metaline b{color:#fff;font-weight:600}

  /* ---------- Health band ---------- */
  .band{background:var(--card);margin:22px 40px 0;border:1px solid var(--line);
        border-radius:16px;padding:24px 26px;display:flex;gap:26px;align-items:center;
        flex-wrap:wrap;box-shadow:0 1px 3px rgba(20,30,60,.04)}
  .ograde{width:96px;height:96px;border-radius:20px;display:flex;flex-direction:column;
          align-items:center;justify-content:center;color:#fff;flex:none;
          box-shadow:0 6px 18px rgba(20,30,60,.18)}
  .ograde .g{font-size:42px;font-weight:800;line-height:1}
  .ograde .gl{font-size:9px;letter-spacing:.14em;text-transform:uppercase;margin-top:3px;opacity:.9}
  .band .htext{flex:1;min-width:220px}
  .band .htext .k{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);font-weight:600}
  .band .htext .v{font-size:19px;color:var(--ink);font-weight:700;margin:3px 0 2px;line-height:1.3}
  .band .htext .d{font-size:12.5px;color:var(--muted)}
  .tiles{display:flex;gap:10px;flex-wrap:wrap}
  .tile{min-width:78px;border-radius:12px;padding:12px 14px;text-align:center;background:var(--bg);
        border:1px solid var(--line)}
  .tile .n{font-size:24px;font-weight:800;line-height:1}
  .tile .l{font-size:10px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin-top:5px;font-weight:600}
  .tile.pass .n{color:var(--pass)} .tile.warn .n{color:var(--warn)}
  .tile.fail .n{color:var(--fail)} .tile.info .n{color:var(--info)}

  .gA{background:var(--gA)} .gB{background:var(--gB)} .gC{background:var(--gC)}
  .gD{background:var(--gD)} .gF{background:var(--gF)}

  /* ---------- Section wrapper ---------- */
  .inner{padding:0 40px}
  h2.sec{font-size:12px;text-transform:uppercase;letter-spacing:.18em;color:var(--muted);
         font-weight:700;margin:34px 0 4px}
  h2.sec .n{color:var(--accent)}
  .sechead{font-size:22px;color:var(--ink);font-weight:700;margin:2px 0 6px;line-height:1.25}
  .secsub{color:var(--muted);font-size:13px;margin:0 0 14px;max-width:78ch}

  /* ---------- Scorecard ---------- */
  .scorecard{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:14px}
  .sc{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;
      display:flex;align-items:center;gap:13px;break-inside:avoid}
  .sc .badge-g{width:46px;height:46px;border-radius:12px;color:#fff;flex:none;
               display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800}
  .sc .lab{font-size:13px;font-weight:700;color:var(--ink)}
  .sc .sub{font-size:11px;color:var(--muted);margin-top:1px;line-height:1.35}

  /* ---------- Hero screenshot ---------- */
  .hero{display:flex;gap:20px;margin-top:16px;background:var(--card);border:1px solid var(--line);
        border-radius:16px;padding:18px;align-items:flex-start}
  .hero img{width:300px;border:1px solid var(--line);border-radius:8px;flex:none}
  .hero .hb{font-size:12.5px;color:var(--muted);padding-top:4px}
  .hero .hb b{color:var(--ink)}

  /* ---------- AI section ---------- */
  .ai{background:var(--card);border:1px solid var(--line);border-radius:16px;
      padding:24px 26px;margin-top:16px}
  .ai .ai-head{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
  .ai .grade{width:66px;height:66px;border-radius:16px;display:flex;align-items:center;
             justify-content:center;font-size:30px;font-weight:800;color:#fff;background:var(--info);flex:none}
  .ai .grade.A{background:var(--gA)} .ai .grade.B{background:var(--gB)}
  .ai .grade.C{background:var(--gC)} .ai .grade.D{background:var(--gD)} .ai .grade.F{background:var(--gF)}
  .ai .htext{flex:1;min-width:220px}
  .ai .eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);font-weight:600}
  .ai .headline{font-size:18px;font-weight:700;margin:3px 0 0;line-height:1.35;color:var(--ink)}
  .ai .scorebox{text-align:center;flex:none}
  .ai .scorebox .n{font-size:28px;font-weight:800;line-height:1;color:var(--ink)}
  .ai .scorebox .l{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
  .ai .summary-text p{margin:12px 0 0}
  .ai h4{font-size:12px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);
         margin:22px 0 8px;border-bottom:1px solid var(--line);padding-bottom:6px;font-weight:700}
  .finding{border-left:3px solid var(--line);padding:6px 0 6px 14px;margin:12px 0}
  .finding.critical{border-color:var(--fail)} .finding.high{border-color:var(--gD)}
  .finding.medium{border-color:var(--warn)} .finding.low{border-color:var(--info)}
  .finding .ft{display:flex;justify-content:space-between;gap:10px;align-items:baseline}
  .finding .ft b{font-size:14px;color:var(--ink)}
  .sev{font-size:9px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
       padding:2px 8px;border-radius:20px;color:#fff;white-space:nowrap}
  .sev.critical{background:var(--fail)} .sev.high{background:var(--gD)}
  .sev.medium{background:var(--warn)} .sev.low{background:var(--info)}
  .sev.informational{background:var(--muted)}
  .finding .rec{margin-top:4px;font-size:12.5px}
  ul.wins{margin:6px 0 0;padding-left:20px} ul.wins li{margin:6px 0}
  .ai .ai-foot{font-size:10px;color:var(--muted);margin-top:18px}

  /* ---------- Data tables ---------- */
  table.data{width:100%;border-collapse:collapse;font-size:12.5px;background:var(--card);
             border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-top:12px}
  table.data thead th{background:var(--ink);color:#fff;text-align:left;padding:10px 12px;
       font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;font-weight:700}
  table.data tbody td{padding:10px 12px;border-top:1px solid var(--line);vertical-align:top}
  table.data tbody tr:nth-child(even){background:#fafbfc}
  table.data .issue-name{font-weight:700;color:var(--ink)}
  table.data .sub{color:var(--muted);font-size:11.5px;margin-top:2px;line-height:1.45}
  .nowrap{white-space:nowrap}

  /* ---------- Callout ---------- */
  .callout{background:#fffbe6;border:1px solid #f0dc8a;border-left:5px solid var(--gold);
           border-radius:10px;padding:16px 20px;margin-top:16px}
  .callout .h{font-weight:800;color:var(--ink);margin-bottom:4px;font-size:14px}
  .callout p{margin:0;color:var(--body)}

  /* ---------- Metric strip ---------- */
  .mstrip{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:12px}
  .ms{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:15px 16px;break-inside:avoid}
  .ms .n{font-size:26px;font-weight:800;color:var(--ink);line-height:1.1}
  .ms .l{font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);
         margin-top:6px;font-weight:600}
  .ms .h{font-size:11px;color:var(--muted);margin-top:5px;line-height:1.4}

  /* ---------- Check cards ---------- */
  .cards{margin-top:12px}
  .card{background:var(--card);border:1px solid var(--line);border-left-width:4px;
        border-radius:12px;padding:15px 18px;margin:11px 0;break-inside:avoid}
  .card.pass{border-left-color:var(--pass)} .card.warn{border-left-color:var(--warn)}
  .card.fail{border-left-color:var(--fail)} .card.info{border-left-color:var(--info)}
  .card .top{display:flex;justify-content:space-between;align-items:center;gap:12px}
  .card h3{font-size:15px;margin:0;color:var(--ink);font-weight:700}
  .pill{font-size:10px;font-weight:700;letter-spacing:.05em;padding:4px 11px;border-radius:20px;
        color:#fff;white-space:nowrap;text-transform:uppercase}
  .pill.pass{background:var(--pass)} .pill.warn{background:var(--warn)}
  .pill.fail{background:var(--fail)} .pill.info{background:var(--info)}
  .card .summary{margin:8px 0 2px;color:var(--body)}
  table.kv{border-collapse:collapse;margin:10px 0 2px;width:100%}
  table.kv td{border-top:1px solid var(--line);padding:6px 10px;vertical-align:top;font-size:12.5px}
  table.kv td.k{color:var(--muted);width:32%;white-space:nowrap;font-weight:600}

  .note{font-size:11px;color:var(--muted);font-style:italic;margin-top:8px}
  footer{margin:38px 40px 0;border-top:1px solid var(--line);padding-top:16px;
         color:var(--muted);font-size:11px;line-height:1.6}

  @media print{
    body{background:#fff} .band,.sc,.hero,.ai,.card,.ms{box-shadow:none}
    .cover{border-radius:0}
    table.data thead{display:table-header-group}
    table.data tr,.ms,.sc,.card{page-break-inside:avoid}
    .pagebreak{page-break-before:always}
  }
</style>
</head>
<body>
<div class="wrap">

  {# ---------------- Cover ---------------- #}
  <header class="cover">
    <div class="eyebrow">Current Digital Health Assessment</div>
    <h1>{{ client_name }}</h1>
    <div class="u">{{ url }}</div>
    <div class="metaline">
      <span>Prepared <b>{{ generated }}</b></span>
      <span><b>{{ results|length }}</b> checks performed</span>
      {% if issues %}<span><b>{{ issues|length }}</b> issues found</span>{% endif %}
      {% if home_status %}<span>Site status <b>HTTP {{ home_status }}</b></span>{% endif %}
    </div>
  </header>

  {# ---------------- Health band ---------------- #}
  {% set labels = {"pass":"Good","warn":"Improve","fail":"Action needed","info":"Informational"} %}
  <div class="band">
    {% if overall %}
    <div class="ograde g{{ overall.letter }}">
      <div class="g">{{ overall.grade }}</div><div class="gl">Overall</div>
    </div>
    <div class="htext">
      <div class="k">Overall health</div>
      <div class="v">{{ overall.title or "Site health summary" }}</div>
      <div class="d">{{ summary.pass }} checks healthy · {{ summary.warn }} to improve · {{ summary.fail }} need action</div>
    </div>
    {% else %}
    <div class="htext">
      <div class="k">Audit summary</div>
      <div class="v">{{ summary.pass }} healthy · {{ summary.warn }} to improve · {{ summary.fail }} need action</div>
      <div class="d">Across {{ results|length }} technical checks on {{ domain }}.</div>
    </div>
    {% endif %}
    <div class="tiles">
      <div class="tile pass"><div class="n">{{ summary.pass }}</div><div class="l">Good</div></div>
      <div class="tile warn"><div class="n">{{ summary.warn }}</div><div class="l">Improve</div></div>
      <div class="tile fail"><div class="n">{{ summary.fail }}</div><div class="l">Fix</div></div>
      <div class="tile info"><div class="n">{{ summary.info }}</div><div class="l">Info</div></div>
    </div>
  </div>

  <div class="inner">

  {# ---------------- Scorecard ---------------- #}
  {% if scorecard %}
  <h2 class="sec">Scorecard</h2>
  <div class="scorecard">
    {% for c in scorecard %}
    <div class="sc">
      <div class="badge-g g{{ c.letter }}">{{ c.grade }}</div>
      <div><div class="lab">{{ c.label }}</div>{% if c.title %}<div class="sub">{{ c.title }}</div>{% endif %}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {# ---------------- What we discovered ---------------- #}
  {% if ai %}
  <h2 class="sec">What We Discovered</h2>
  <section class="ai">
    <div class="ai-head">
      <div class="grade {{ ai.grade }}">{{ ai.grade }}</div>
      <div class="htext">
        <div class="eyebrow">Analyst overview</div>
        <div class="headline">{{ ai.headline }}</div>
      </div>
      {% if ai.score is not none %}
      <div class="scorebox"><div class="n">{{ ai.score }}</div><div class="l">/ 100 Health</div></div>
      {% endif %}
    </div>
    {% if ai.executive_summary %}
    <div class="summary-text">
      {% for para in ai.executive_summary.split("\n") if para.strip() %}<p>{{ para.strip() }}</p>{% endfor %}
    </div>
    {% endif %}
    {% if ai.key_findings %}
    <h4>Key Findings &amp; Recommendations</h4>
    {% for f in ai.key_findings %}
    <div class="finding {{ f.severity }}">
      <div class="ft"><b>{{ f.title }}</b><span class="sev {{ f.severity }}">{{ f.severity }}</span></div>
      <div>{{ f.finding }}</div>
      {% if f.recommendation %}<div class="rec"><b>Recommendation:</b> {{ f.recommendation }}</div>{% endif %}
    </div>
    {% endfor %}
    {% endif %}
    {% if ai.quick_wins %}
    <h4>Quick Wins</h4>
    <ul class="wins">{% for w in ai.quick_wins %}<li>{{ w }}</li>{% endfor %}</ul>
    {% endif %}
    <div class="ai-foot">Interpretive summary of the automated checks in this report.</div>
  </section>
  {% endif %}

  {# ---------------- Critical issues ---------------- #}
  {% if issues %}
  <h2 class="sec">01 · Issues Requiring Attention</h2>
  <div class="sechead">What's actively holding your rankings back</div>
  <p class="secsub">Every row below is a measured finding from the live site, ordered by what it
    costs you in search. These are the items a campaign fixes first.</p>
  <table class="data">
    <thead><tr>
      <th style="width:22%">Issue</th><th style="width:12%">Severity</th>
      <th style="width:22%">Measured extent</th><th>Impact on rankings</th>
    </tr></thead>
    <tbody>
      {% for i in issues %}
      <tr>
        <td><div class="issue-name">{{ i.issue }}</div>
            {% if i.summary %}<div class="sub">{{ i.summary }}</div>{% endif %}</td>
        <td class="nowrap"><span class="sev {{ i.severity|lower }}">{{ i.severity }}</span></td>
        <td>{{ i.extent }}</td>
        <td>{{ i.impact }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <div class="callout">
    <div class="h">What this means</div>
    <p>{{ issues|selectattr("status","equalto","fail")|list|length }} of these are outright failures and
      {{ issues|selectattr("status","equalto","warn")|list|length }} are warnings. Every day they persist,
      you're handing qualified searchers to competitors with cleaner, faster, better-structured sites.
      None of them are permanent — they're a work queue, and that queue is where a campaign starts.</p>
  </div>
  {% else %}
  <h2 class="sec">01 · Issues Requiring Attention</h2>
  <div class="callout">
    <div class="h">No critical issues found</div>
    <p>Every automated check on {{ domain }} came back healthy or informational. The opportunity
      here is growth — coverage, authority and content — rather than repair.</p>
  </div>
  {% endif %}

  {# ---------------- Homepage analysis ---------------- #}
  {% if homepage %}
  <h2 class="sec">02 · Homepage Analysis</h2>
  <div class="sechead">Your most important page, element by element</div>
  <p class="secsub">The homepage carries more authority than any other URL on the domain. This is
    what it's telling search engines today.</p>
  <table class="data">
    <thead><tr><th style="width:20%">Element</th><th style="width:32%">Currently</th><th>Assessment</th></tr></thead>
    <tbody>
      {% for h in homepage %}
      <tr>
        <td class="issue-name">{{ h.element }}</td>
        <td>{{ h.current }}</td>
        <td><span class="pill {{ h.status }}" style="margin-right:8px">{{ labels[h.status] }}</span>{{ h.verdict }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {# ---------------- Homepage preview ---------------- #}
  {% if has_home_shot %}
  <div class="hero">
    <img src="assets/_homepage.png" alt="homepage preview">
    <div class="hb"><b>{{ domain }}</b> as captured during the audit. Every finding in this
      report was verified against the live site through an automated browser and trusted
      third-party data sources.</div>
  </div>
  {% endif %}

  {# ---------------- Current organic performance ---------------- #}
  {% if metrics.positions or metrics.organic_traffic is not none %}
  <h2 class="sec">03 · Current Organic Performance</h2>
  <div class="sechead">Where you rank, and what it's worth today</div>
  <p class="secsub">Position 1-3 captures the overwhelming majority of clicks; anything past
    position 10 earns almost none. This is your current distribution.</p>
  <div class="mstrip">
    {% if metrics.organic_traffic is not none %}
    <div class="ms"><div class="n">{{ "{:,}".format(metrics.organic_traffic) }}</div>
      <div class="l">Monthly organic visits</div>
      <div class="h">Estimated traffic from Google organic search.</div></div>
    {% endif %}
    {% if metrics.keywords_total is not none %}
    <div class="ms"><div class="n">{{ metrics.keywords_total }}</div>
      <div class="l">Ranking keywords tracked</div>
      <div class="h">Keywords found ranking in the top 100.</div></div>
    {% endif %}
    {% if metrics.positions %}
    <div class="ms"><div class="n">{{ metrics.positions["1-3"] }}</div>
      <div class="l">In positions 1-3</div>
      <div class="h">The only positions that reliably earn clicks.</div></div>
    <div class="ms"><div class="n">{{ metrics.positions["11-20"] + metrics.positions["21-50"] + metrics.positions["51-100"] }}</div>
      <div class="l">Stranded past page 1</div>
      <div class="h">Ranking, but earning almost no traffic — the fastest wins live here.</div></div>
    {% endif %}
  </div>

  {% if metrics.positions %}
  <table class="data">
    <thead><tr><th>Ranking band</th><th>Keywords</th><th>What it means</th></tr></thead>
    <tbody>
      <tr><td class="issue-name">Positions 1-3</td><td>{{ metrics.positions["1-3"] }}</td>
        <td>Capturing meaningful traffic today.</td></tr>
      <tr><td class="issue-name">Positions 4-10</td><td>{{ metrics.positions["4-10"] }}</td>
        <td>On page one, but below the fold of attention — realistic promotion targets.</td></tr>
      <tr><td class="issue-name">Positions 11-20</td><td>{{ metrics.positions["11-20"] }}</td>
        <td>Page two. Closest to a quick win: small gains move these onto page one.</td></tr>
      <tr><td class="issue-name">Positions 21-50</td><td>{{ metrics.positions["21-50"] }}</td>
        <td>Recognised by Google but uncompetitive; needs content and authority work.</td></tr>
      <tr><td class="issue-name">Positions 51-100</td><td>{{ metrics.positions["51-100"] }}</td>
        <td>Indexed only. Effectively invisible to searchers.</td></tr>
    </tbody>
  </table>
  {% endif %}

  {% if metrics.top_keywords %}
  <h2 class="sec">Your top ranking keywords today</h2>
  <table class="data">
    <thead><tr><th style="width:38%">Keyword</th><th>Market</th><th>Position</th>
      <th>Monthly searches</th><th>Est. traffic</th></tr></thead>
    <tbody>
      {% for k in metrics.top_keywords %}
      <tr><td class="issue-name">{{ k.keyword }}</td><td>{{ k.country or "—" }}</td>
        <td>#{{ k.position }}</td><td>{{ k.volume or "—" }}</td><td>{{ k.traffic or "—" }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="note">Search volume and traffic estimates come from our third-party ranking data
    provider and reflect a sample of tracked keywords, not the complete universe of terms your
    site ranks for. A full keyword map is built during the campaign's research phase.</p>
  {% endif %}
  {% endif %}

  {# ---------------- Backlink profile ---------------- #}
  {% if metrics.referring_domains is not none or metrics.backlinks is not none %}
  <h2 class="sec">04 · Backlink Profile</h2>
  <div class="sechead">The authority behind your rankings</div>
  <p class="secsub">Links from other websites remain the strongest off-page ranking factor. What
    matters is not raw volume but how many <em>distinct, credible</em> domains vouch for you.</p>
  <div class="mstrip">
    {% if metrics.domain_strength is not none %}
    <div class="ms"><div class="n">{{ metrics.domain_strength }}</div>
      <div class="l">Domain strength</div>
      <div class="h">Overall authority, scored 0-100.</div></div>
    {% endif %}
    {% if metrics.referring_domains is not none %}
    <div class="ms"><div class="n">{{ "{:,}".format(metrics.referring_domains) }}</div>
      <div class="l">Referring domains</div>
      <div class="h">Distinct websites linking to you — the number that counts.</div></div>
    {% endif %}
    {% if metrics.backlinks is not none %}
    <div class="ms"><div class="n">{{ "{:,}".format(metrics.backlinks) }}</div>
      <div class="l">Total backlinks</div>
      <div class="h">Individual links, including many from the same domains.</div></div>
    {% endif %}
    {% if metrics.dofollow_backlinks is not none %}
    <div class="ms"><div class="n">{{ "{:,}".format(metrics.dofollow_backlinks) }}</div>
      <div class="l">Authority-passing links</div>
      <div class="h">Dofollow links — the ones that transfer ranking value.</div></div>
    {% endif %}
  </div>
  {% if metrics.top_backlinks %}
  <table class="data">
    <thead><tr><th style="width:42%">Strongest links pointing at you</th><th>Anchor text</th>
      <th class="nowrap">Domain strength</th></tr></thead>
    <tbody>
      {% for b in metrics.top_backlinks %}
      <tr><td><div class="issue-name">{{ b.title or b.url }}</div>
              <div class="sub">{{ b.url }}</div></td>
          <td>{{ b.anchor or "—" }}</td>
          <td>{{ b.strength if b.strength is not none else "—" }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% endif %}

  {# ---------------- Detailed findings ---------------- #}
  <div class="pagebreak"></div>
  <h2 class="sec">Appendix · Full Technical Detail</h2>
  <div class="sechead">Every check we ran</div>
  <p class="secsub">The complete result set behind the summary above, grouped by theme.</p>

  {% for cat, items in grouped %}
  <h2 class="sec">{{ cat }}</h2>
  <div class="cards">
    {% for r in items %}
    <div class="card {{ r.status.value }}">
      <div class="top">
        <h3>{{ r.title }}</h3>
        <span class="pill {{ r.status.value }}">{{ labels[r.status.value] }}</span>
      </div>
      {% if r.summary %}<div class="summary">{{ r.summary }}</div>{% endif %}
      {% if r.details %}
      <table class="kv">
        {% for k,v in r.details %}<tr><td class="k">{{ k }}</td>
          <td>{% if v is string and v.startswith("http") %}<a href="{{ v }}">{{ v }}</a>{% else %}{{ v }}{% endif %}</td></tr>{% endfor %}
      </table>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endfor %}

  </div>{# /inner #}

  <footer>
    <b>Methodology &amp; scope.</b> This audit combines live technical checks performed through a
    headless browser (SSL, DNS/WHOIS, on-page markup, response timing, crawl directives) with
    third-party intelligence for backlinks, organic visibility, off-page performance and social
    signals. On-page findings are measured on the homepage and domain-level signals; a full-site
    crawl covering every URL is the first deliverable of the campaign's foundation phase. Ranking
    and traffic figures are third-party estimates over a sample of tracked keywords. Grades reflect
    the site's state at the time of audit.
    <br>Generated by bd-auto v{{ version }} · {{ generated }}
    {% if home_error %}<br><span style="color:var(--fail)">Note: the homepage returned a load
    issue during capture ({{ home_error }}).</span>{% endif %}
  </footer>

</div>
</body>
</html>
